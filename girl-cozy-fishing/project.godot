; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Maré — pesca cozy"
config/description="Widget de pesca cozy que mora no canto da tela: clicker de pesca com evolução, lugares para visitar e cosméticos."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SaveSystem="*res://scripts/systems/save_system.gd"
GameState="*res://scripts/systems/game_state.gd"
Audio="*res://scripts/systems/audio.gd"

[display]

window/size/viewport_width=460
window/size/viewport_height=230
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
viewport/transparent_background=true
